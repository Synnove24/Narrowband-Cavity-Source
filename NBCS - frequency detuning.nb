   RowBox[{"(*", "THz", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]o", " ", "=", " ", 
     RowBox[{"2", "*", "Pi", "*", "fo", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", "12", ")"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"rad", "/", "s"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]\[Lambda]", " ", "=", " ", 
     RowBox[{"94", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "9"}], ")"}]}]}]}], ";"}], "  ", 
   RowBox[{"(*", "m", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalDelta]f", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "*", 
          RowBox[{"10", "^", "8"}]}], ")"}], "/", 
        RowBox[{"\[Lambda]", "^", "2"}]}], "*", "\[CapitalDelta]\[Lambda]"}], 
      ")"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "12"}], ")"}]}]}]}], " ", 
   RowBox[{"(*", "Thz", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
