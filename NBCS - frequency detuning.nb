 RowBox[{
  RowBox[{
   RowBox[{"RC2", "[", 
    RowBox[{"z_", ",", "RC_", ",", "L_"}], "]"}], " ", ":=", "  ", 
   RowBox[{"z", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"z0", "[", 
