  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RC1", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
    FractionBox[
     RowBox[{"2", "*", 
      RowBox[{"mB", "[", 
       RowBox[{"RC", ",", "L"}], "]"}]}], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mA", "[", 
         RowBox[{"RC", ",", "L"}], "]"}], "-", 
        RowBox[{"mD", "[", 
         RowBox[{"RC", ",", "L"}], "]"}]}], ")"}]}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Radius", " ", "of", " ", "curvature", " ", "of", " ", "Gaussian", " ", 
    "beam", " ", "at", " ", "first", " ", "flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"W1", "[", 
