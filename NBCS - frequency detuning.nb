          RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]s", "[", "\[Nu]_", "]"}], ":=", 
     RowBox[{"c", "/", "\[Nu]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]i", "[", "\[Nu]_", "]"}], ":=", 
     RowBox[{"c", "/", "\[Nu]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", " ", "=", " ", 
     RowBox[{".5", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]so", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"c", "/", "\[Lambda]so"}], ")"}], " ", "/", 
      RowBox[{"10", "^", "9"}]}]}], ";"}], "\[IndentingNewLine]", 
