  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stability", "[", 
    RowBox[{"RC1_", ",", " ", "RC2_", ",", " ", "L_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["L", "RC1"]}], ")"}], 
