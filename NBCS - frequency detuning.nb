              RowBox[{"RC", ",", "L"}], "]"}]}], "2"], ")"}], "2"]}]]]]}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "beam", " ", "waist", " ", "at", " ", "first", " ", "flat", " ", 
    "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z0", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"nz", "[", 
      RowBox[{"\[Lambda]so", "*", 
       SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]", "*", 
