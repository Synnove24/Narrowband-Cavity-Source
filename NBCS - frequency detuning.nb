            RowBox[{"\[Pi]", "*", "\[CapitalDelta]\[Nu]"}], 
            RowBox[{"\[Nu]f", "[", "L", "]"}]], "]"}], ")"}], "2"]}]}]]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
