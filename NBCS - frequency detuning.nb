Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{"ArcTan", "[", 
    FractionBox["L", 
     RowBox[{"z0", "[", 
      RowBox[{"RC", ",", "L"}], "]"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]2", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArcCos", "[", 
    SqrtBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"L", "/", "RC"}]}], ")"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"q_", ",", "z_", ",", "m_", ",", "RC_", ",", "L_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"q", "*", 
     RowBox[{"\[Nu]f", "[", "L", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "+", "m", "+", "1"}], ")"}], " ", 
     FractionBox[
      RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "\[Pi]"], 
     RowBox[{"\[Nu]f", "[", "L", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shift", " ", "[", 
    RowBox[{
    "q1_", ",", "z1_", ",", "m1_", ",", "q2_", ",", "z2_", ",", "m2_", ",", 
     "RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q2", ",", "z2", ",", "m2", ",", "RC", ",", "L"}], "]"}], " ", "-",
     " ", 
