    RowBox[{"Imax", " ", "=", " ", 
     FractionBox["Io", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"r1", "*", "r2"}]}], ")"}], "2"]]}], ";"}], "\[IndentingNewLine]", 
