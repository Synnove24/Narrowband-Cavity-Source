fbf384418292"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", " ", "=", " ", 
     RowBox[{".5", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]so", " ", "=", " ", 
     RowBox[{"780", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Reflectivity", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R1", " ", "=", " ", ".999"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R2", " ", "=", " ", ".98"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r1", " ", "=", " ", 
     SqrtBox["R1"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r2", " ", "=", " ", 
     SqrtBox["R2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "loss", " ", "coefficient", " ", "for", " ", "absorption", " ", "for", " ",
      "PPKTP", " ", "at", " ", "775", " ", 
     RowBox[{"(", 
      RowBox[{"ppm", "/", "cm"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]s", " ", "=", " ", 
     RowBox[{"127", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]], "*", "100"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]r", " ", "=", " ", 
     RowBox[{"\[Alpha]s", "+", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "L"}]], 
       RowBox[{"Log", "[", 
        FractionBox["1", 
         RowBox[{"R1", "*", "R2"}]], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Alpha]r", " ", "=", " ", ".18633"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Finesse", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fnoloss", " ", "=", " ", 
     FractionBox[
      RowBox[{"\[Pi]", 
       SqrtBox[
        RowBox[{"r1", "*", "r2"}]]}], 
      RowBox[{"1", "-", 
       RowBox[{"r1", "*", "r2"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", " ", "=", " ", 
     FractionBox[
      RowBox[{"\[Pi]", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]r"}], "*", 
         RowBox[{"L", "/", "2"}]}], "]"}]}], 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]r"}], "*", "L"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The finesse is \>\"", ",", " ", 
      RowBox[{"N", "[", "F", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Free", " ", "spectral", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]f", " ", "=", " ", 
     FractionBox[
      RowBox[{"c", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], 
      RowBox[{"2", "*", "L", "*", 
       RowBox[{"nz", "[", 
        RowBox[{"\[Lambda]so", "*", 
         SuperscriptBox["10", "6"]}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ng", "[", "\[Lambda]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"nz", "[", "\[Lambda]", "]"}], "-", 
      RowBox[{"\[Lambda]", "*", 
       RowBox[{
        RowBox[{"nz", "'"}], "[", "\[Lambda]", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]fg", " ", "=", " ", 
     FractionBox[
      RowBox[{"c", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], 
      RowBox[{"2", "*", "L", "*", 
       RowBox[{"ng", "[", 
        RowBox[{"\[Lambda]so", "*", 
         SuperscriptBox["10", "6"]}], "]"}]}]]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<the group index is: \>\"", ",", 
       RowBox[{"ng", "[", 
        RowBox[{"\[Lambda]so", "*", 
         RowBox[{"10", "^", "6"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<the normal index is: \>\"", ",", " ", 
       RowBox[{"nz", "[", 
        RowBox[{"\[Lambda]so", "*", 
         RowBox[{"10", "^", "6"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<The FSR using group index is: \>\"", ",", " ", "\[Nu]fg", ",",
        " ", "\"\< GHz\>\""}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spectral", " ", "width"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sw", " ", "=", " ", 
     FractionBox["\[Nu]f", "F"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"swnoloss", " ", "=", " ", 
     FractionBox["\[Nu]f", "Fnoloss"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The spectral width is: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"N", "[", "sw", "]"}], "*", 
      RowBox[{"10", "^", "9"}]}], ",", " ", "\"\< Hz\>\""}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The spectral width with no loss is: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"N", "[", "swnoloss", "]"}], "*", 
      RowBox[{"10", "^", "9"}]}], ",", " ", "\"\< Hz\>\""}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Internal", " ", "resonator", " ", "intensity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Io", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Imax", " ", "=", " ", 
     FractionBox["Io", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"r1", "*", "r2"}]}], ")"}], "2"]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The free spectral range is \>\"", ",", "\[Nu]f", ",", 
     " ", "\"\< GHz\>\""}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Intensity", "[", " ", "\[CapitalDelta]\[Nu]_", "]"}], ":=", " ", 
     FractionBox["Imax", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"2", "*", "F"}], "\[Pi]"], ")"}], "2"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Pi]", "*", "\[CapitalDelta]\[Nu]"}], "\[Nu]f"], "]"}], 
          ")"}], "2"]}]}]]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qso", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"\[Nu]so", "/", "\[Nu]f"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"closest", " ", "mode", " ", "to", " ", "signal"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Nu]r", "=", 
     RowBox[{"qso", "*", "\[Nu]f"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "resonant", " ", "frequency", " ", "closest", " ", "to", " ", "signal"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]\[Nu]r", "=", 
     RowBox[{"\[Nu]r", "-", "\[Nu]so"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"how", " ", "far", " ", "apart", " ", "they", " ", "are"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]\[Nu]2", " ", "=", " ", "7"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Intensity", "[", "\[CapitalDelta]\[Nu]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Frequency", 
         RowBox[{"(", "GHz", ")"}]}], ",", " ", "Intensity"}], "}"}]}]}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10004.},
