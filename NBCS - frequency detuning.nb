     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "*", 
          RowBox[{"10", "^", "8"}]}], ")"}], "/", 
        RowBox[{"\[Lambda]", "^", "2"}]}], "*", "\[CapitalDelta]\[Lambda]"}], 
      ")"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "12"}], ")"}]}]}]}], " ", 
   RowBox[{"(*", "Thz", "*)"}], "\[IndentingNewLine]", 
