    RowBox[{"\[CapitalDelta]\[Lambda]", " ", "=", " ", 
     RowBox[{"94", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "9"}], ")"}]}]}]}], ";"}], "  ", 
