     FractionBox["Imax", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"2", "*", 
            RowBox[{"F", "[", 
