Cell[CellGroupData[{

Cell["ABCD Matrices for Hemispherical Cavity", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
 CellChangeTimes->{{3.987793201770483*^9, 
  3.987793257750599*^9}},ExpressionUUID->"d6daf963-b725-4a48-a789-\
0e15395317a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RC", " ", "=", " ", 
    RowBox[{"1", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]so", " ", "=", " ", 
   RowBox[{"780", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", 
   RowBox[{".5", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m2", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", "propagation", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m3", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "/", "RC"}], ",", "1"}], "}"}]}], "}"}]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{"curved", " ", "mirror"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ABCD", " ", "=", " ", 
   RowBox[{"m1", ".", "m2", ".", "m3", ".", "m2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ABCD Matrix: \>\"", ",", " ", "ABCD"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mA", " ", "=", " ", 
   RowBox[{"ABCD", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mB", " ", "=", " ", 
   RowBox[{"ABCD", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mC", " ", "=", " ", 
   RowBox[{"ABCD", "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mD", " ", "=", " ", 
    RowBox[{"ABCD", "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RC1", " ", "=", " ", 
    FractionBox[
     RowBox[{"2", "*", "mB"}], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"mA", "-", "mD"}], ")"}]}]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Radius", " ", "of", " ", "curvature", " ", "of", " ", "Gaussian", " ", 
    "beam", " ", "at", " ", "first", " ", "flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"W1", " ", "=", 
    RowBox[{
     SqrtBox[
      RowBox[{"(", 
       FractionBox["\[Lambda]so", 
        RowBox[{
         RowBox[{"nz", "[", 
          RowBox[{"\[Lambda]so", "*", 
           SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]"}]], ")"}]], 
     SqrtBox[
      FractionBox[
       RowBox[{"Abs", "[", "mB", "]"}], 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"mA", "+", "mD"}], "2"], ")"}], "2"]}]]]]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "beam", " ", "waist", " ", "at", " ", "first", " ", "flat", " ", 
    "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z0", " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"nz", "[", 
      RowBox[{"\[Lambda]so", "*", 
       SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]", "*", 
     SuperscriptBox["W1", "2"]}], "\[Lambda]so"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RC2", " ", "=", " ", 
   RowBox[{"L", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"(", 
       FractionBox["z0", "L"], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"W2", " ", "=", " ", 
    RowBox[{"W1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["L", "z0"], ")"}], "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The radius of curvature of the beam at the first mirror is \>\
\"", ",", 
    RowBox[{"N", "[", "RC1", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The beam waist at the first mirror is \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{"W1", "*", 
      SuperscriptBox["10", "6"]}], "]"}], ",", " ", "\"\< microns\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The radius of curvature of the beam at the second mirror is \
\>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{"RC2", "*", 
      SuperscriptBox["10", "2"]}], "]"}], ",", " ", "\"\< cm\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The beam waist at the second mirror is \>\"", ",", 
     RowBox[{"N", "[", 
      RowBox[{"W2", "*", 
       SuperscriptBox["10", "6"]}], "]"}], ",", " ", "\"\< microns\>\""}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
