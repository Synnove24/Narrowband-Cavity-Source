 RowBox[{
  RowBox[{"\[CapitalDelta]\[Zeta]", " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{"ArcTan", "[", 
     FractionBox["L", "z0"], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]\[Zeta]2", " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{"ArcCos", "[", 
     SqrtBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"L", "/", "RC"}]}], ")"}]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"q_", ",", "l_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"q", "*", "\[Nu]f"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"l", "+", "m", "+", "1"}], ")"}], " ", 
     FractionBox["\[CapitalDelta]\[Zeta]", "\[Pi]"], "\[Nu]f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
