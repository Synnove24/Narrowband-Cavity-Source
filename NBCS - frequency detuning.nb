   RowBox[{"(*", 
    RowBox[{"closest", " ", "mode", " ", "to", " ", "signal"}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]r", "[", "L_", "]"}], ":=", 
     RowBox[{
      RowBox[{"qso", "[", "L", "]"}], "*", 
      RowBox[{"\[Nu]f", "[", "L", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
