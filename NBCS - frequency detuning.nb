fbf384418292"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", " ", "=", " ", 
     RowBox[{"1", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Reflectivity", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R1", " ", "=", " ", ".99"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R2", " ", "=", " ", ".99"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "loss", " ", "coefficient", " ", "for", " ", "absorption", " ", "for", " ",
      "PPKTP", " ", "at", " ", "775", " ", 
     RowBox[{"(", 
      RowBox[{"ppm", "/", "cm"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]s", " ", "=", " ", 
     RowBox[{"127", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]r", " ", "=", " ", 
     RowBox[{"\[Alpha]s", "+", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "L"}]], 
       RowBox[{"Log", "[", 
        FractionBox["1", 
         RowBox[{"R1", "*", "R2"}]], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Finesse", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"F", " ", "=", " ", 
      FractionBox[
       RowBox[{"\[Pi]", 
        SqrtBox["R"]}], 
       RowBox[{"1", "-", "R"}]]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", " ", "=", " ", 
     FractionBox[
      RowBox[{"\[Pi]", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]r"}], "*", 
         RowBox[{"L", "/", "2"}]}], "]"}]}], 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]r"}], "*", "L"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The finesse is \>\"", ",", " ", 
      RowBox[{"N", "[", "F", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Free", " ", "spectral", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]f", " ", "=", " ", 
     FractionBox[
      RowBox[{"c", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], 
      RowBox[{"2", "*", "L", "*", 
       RowBox[{"nz", "[", 
        RowBox[{"\[Lambda]so", "*", 
         SuperscriptBox["10", "6"]}], "]"}]}]]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spectral", " ", "width"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]\[Nu]", " ", "=", " ", 
     FractionBox["\[Nu]f", "F"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Internal", " ", "resonator", " ", "intensity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Io", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"R1", "*", "R2"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Imax", " ", "=", " ", 
     FractionBox["Io", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "R"}], ")"}], "2"]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The free spectral range is \>\"", ",", "\[Nu]f", ",", 
     " ", "\"\< THz\>\""}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Intensity", "[", " ", "\[CapitalDelta]\[Nu]_", "]"}], ":=", " ", 
     FractionBox["Imax", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"2", "*", "F"}], "\[Pi]"], ")"}], "2"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Pi]", "*", "\[CapitalDelta]\[Nu]"}], "\[Nu]f"], "]"}], 
          ")"}], "2"]}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[Delta]\[Nu]2", " ", "=", " ", ".5"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Intensity", "[", "\[CapitalDelta]\[Nu]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]\[Nu]", ",", " ", "Intensity"}], "}"}]}]}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10004.},
