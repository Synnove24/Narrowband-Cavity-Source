c7a3c5cbc448"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"JSA", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s_", ",", "\[CapitalDelta]\[Nu]i_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"\[Phi]", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}],
       "*", 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", " ", "\[CapitalDelta]\[Nu]i"}], 
       "]"}], "*", 
      RowBox[{"Intensity", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", "-", "\[Delta]\[Nu]r"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"JSI", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s_", ",", " ", "\[CapitalDelta]\[Nu]i_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"JSA", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}],
       "*", 
      RowBox[{"Conjugate", "[", 
       RowBox[{"JSA", "[", 
        RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], 
        "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"JSI", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]s", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]i", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", " ", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", 
     RowBox[{"PlotLabel", "->", "\"\<JSI\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Signal (GHz)\>\"", ",", "\"\<idler (Ghz)\>\"", ",", 
        "None", ",", "None"}], "}"}]}]}], "]"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10005.},
 CellChangeTimes->{{3.979752061436159*^9, 3.9797520828853397`*^9}, {
