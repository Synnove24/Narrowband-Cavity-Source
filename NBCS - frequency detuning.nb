Cell["JSI with Higher Order Modes", "Text",
 CellChangeTimes->{{3.9923601454703627`*^9, 3.992360237786633*^9}, 
   3.99236045520919*^9, {3.997368191172819*^9, 
   3.997368224077952*^9}},ExpressionUUID->"f7079001-4ab9-4c02-9453-\
31c831e327e0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"JSAHigherModes", "[", 
    RowBox[{"\[CapitalDelta]\[Nu]s_", ",", "\[CapitalDelta]\[Nu]i_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{"\[Phi]", "[", 
     RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], "*", 
    RowBox[{"\[Alpha]", "[", 
     RowBox[{"\[CapitalDelta]\[Nu]s", ",", " ", "\[CapitalDelta]\[Nu]i"}], 
     "]"}], "*", 
    RowBox[{"TotalIntensity", "[", 
     RowBox[{
     "\[CapitalDelta]\[Nu]s", ",", "RC", ",", "L", ",", "R1", ",", "R2"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JSIHigherModes", "[", 
    RowBox[{"\[CapitalDelta]\[Nu]s_", ",", " ", "\[CapitalDelta]\[Nu]i_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"JSAHigherModes", "[", 
     RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], "*", 
    RowBox[{"Conjugate", "[", 
     RowBox[{"JSAHigherModes", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"JSIHigherModes", "[", 
    RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[CapitalDelta]\[Nu]s", ",", 
     RowBox[{
      RowBox[{"-", "\[Delta]\[Nu]2"}], "/", "3"}], ",", 
     RowBox[{"\[Delta]\[Nu]2", "/", "3"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[CapitalDelta]\[Nu]i", ",", 
     RowBox[{
      RowBox[{"-", "\[Delta]\[Nu]2"}], "/", "3"}], ",", 
     RowBox[{"\[Delta]\[Nu]2", "/", "3"}]}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", " ", 
   RowBox[{"PlotRange", "->", "All"}], ",", " ", 
   RowBox[{"PlotLabel", "->", "\"\<JSI\>\""}], ",", " ", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"FontSize", " ", "->", "14"}]}], ",", " ", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Relative Signal (GHz)\>\"", 
      ",", "\"\<Relative idler (Ghz)\>\"", ",", "None", ",", "None"}], 
     "}"}]}]}], "]"}], "\n"}], "Input",
