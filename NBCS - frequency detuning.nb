   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", " ", "=", " ", 
     RowBox[{"737", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "9"}], ")"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", "m", "*)"}], "\[IndentingNewLine]", 
