Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nair", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"m4", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nz", "[", 
             RowBox[{"\[Lambda]so", "*", 
              SuperscriptBox["10", "6"]}], "]"}], "-", "nair"}], ")"}], 
          RowBox[{"nair", "*", "RC"}]], ",", 
         FractionBox[
          RowBox[{"nz", "[", 
           RowBox[{"\[Lambda]so", "*", 
            SuperscriptBox["10", "6"]}], "]"}], "nair"]}], "}"}]}], "}"}]}], 
    ";"}], " ", 
   RowBox[{"(*", "refraction", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ABCDrefraction", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{"m4", "[", "RC", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mAr", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCDrefraction", "[", "RC", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"mBr", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCDrefraction", "[", "RC", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"mCr", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCDrefraction", "[", "RC", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"mDr", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCDrefraction", "[", "RC", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"qp1", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{"L", " ", "+", " ", 
      RowBox[{"I", "*", 
       RowBox[{"z0", "[", 
        RowBox[{"RC", ",", "L"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"qp2", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"mAr", "[", "RC", "]"}], "*", 
        RowBox[{"qp1", "[", 
         RowBox[{"RC", ",", "L"}], "]"}]}], "+", 
       RowBox[{"mBr", "[", "RC", "]"}]}], 
      RowBox[{
       RowBox[{
        RowBox[{"mCr", "[", "RC", "]"}], "*", 
        RowBox[{"qp1", "[", 
         RowBox[{"RC", ",", "L"}], "]"}]}], " ", "+", " ", 
       RowBox[{"mDr", "[", "RC", "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"zp2", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{"Re", "[", 
       RowBox[{"qp2", "[", 
        RowBox[{"RC", ",", "L"}], "]"}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Distance", " ", "from", " ", "Beam", " ", "waist"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"z02", " ", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], ":=", " ", 
     RowBox[{"Im", "[", 
      RowBox[{"qp2", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Rayleigh", " ", "Range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"W12", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     SqrtBox[
      RowBox[{"\[Lambda]so", "*", 
       FractionBox[
        RowBox[{"z02", "[", 
         RowBox[{"RC", ",", "L"}], "]"}], 
        RowBox[{"\[Pi]", "*", "nair"}]]}]]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Beam", " ", "radius", " ", "at", " ", "waist"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"W22", "[", 
      RowBox[{"z_", ",", "RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"W12", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["z", 
            RowBox[{"z02", "[", 
             RowBox[{"RC", ",", "L"}], "]"}]], ")"}], "2"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "beam", " ", "radius", " ", "as", " ", "a", " ", "function", " ", "of", " ",
      "z", " ", 
     RowBox[{"(", 
      RowBox[{"starting", " ", "from", " ", "waist"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Div2", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     FractionBox["\[Lambda]so", 
      RowBox[{"\[Pi]", "*", "nair", "*", 
       RowBox[{"W12", "[", 
        RowBox[{"RC", ",", "L"}], "]"}]}]]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Divergence", " ", "at", " ", "L"}], "*)"}], 
   "\[IndentingNewLine]", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The beam divergence after exiting the cavity is: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Div2", "[", 
        RowBox[{"RC", ",", "L"}], "]"}], "]"}], ",", 
      " ", "\"\< radians\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusIn", " ", "=", " ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"W2", "[", 
         RowBox[{"z", ",", "RC", ",", "L"}], "]"}], "*", 
        SuperscriptBox["10", "6"]}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "L"}], ",", 
         RowBox[{"6", "L"}]}], "}"}], ",", 
       RowBox[{"PlotPoints", "->", "100"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1000"}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<z (m)\>\"", ",", " ", "\"\<Beam Radius (microns)\>\"", ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<Beam Radius Through Interface\>\""}]}], 
         "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", "StandardBlue"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Inside Cavity\>\"", "}"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed", ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
