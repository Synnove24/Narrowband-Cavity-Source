      FractionBox[
       RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
        RowBox[{"RC", ",", "L"}], "]"}], "\[Pi]"], 
      RowBox[{"\[Nu]f", "[", "L", "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", "resonances", "*)"}]}], "\[IndentingNewLine]", 
