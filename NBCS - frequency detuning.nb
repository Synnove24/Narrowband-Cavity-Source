Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]\[Zeta]", " ", "=", " ", 
   RowBox[{
    RowBox[{"ArcTan", "[", 
     FractionBox["L", 
      RowBox[{"2", "*", "z0"}]], "]"}], "-", 
    RowBox[{"ArcTan", "[", 
     FractionBox[
      RowBox[{"-", "L"}], 
      RowBox[{"2", "*", "z0"}]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"q_", ",", "l_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"q", "*", "\[Nu]f"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"l", "+", "m", "+", "1"}], ")"}], " ", 
     FractionBox["\[CapitalDelta]\[Zeta]", "\[Pi]"], "\[Nu]f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shift", " ", "[", 
    RowBox[{
    "q1_", ",", "l1_", ",", "m1_", ",", "q2_", ",", "l2_", ",", "m2_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q2", ",", "l2", ",", "m2"}], "]"}], " ", "-", " ", 
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q1", ",", "l1", ",", "m1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The frequency shift from TEM00 to TEM01 is \>\"", ",", 
    RowBox[{"shift", "[", 
     RowBox[{"1", ",", "0", ",", "0", ",", "1", ",", "0", ",", "1"}], "]"}], ",",
     " ", "\"\< Ghz\>\""}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<TEM00 resonances: \>\"", ",", 
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"0", ",", "0", ",", "0"}], "]"}], ",", "\"\< GHz\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<TEM01 resonance: \>\"", ",", 
