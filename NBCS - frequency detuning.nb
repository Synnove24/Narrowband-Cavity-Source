Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{"2", 
    RowBox[{"ArcTan", "[", 
     FractionBox["L", 
      RowBox[{"z0", "[", 
       RowBox[{"RC", ",", "L"}], "]"}]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]2", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{"2", 
    RowBox[{"ArcCos", "[", 
     SqrtBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"L", "/", "RC"}]}], ")"}]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"q_", ",", "z_", ",", "m_", ",", "RC_", ",", "L_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"q", "*", "\[Nu]f"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "+", "m", "+", "1"}], ")"}], " ", 
     FractionBox[
      RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "\[Pi]"], "\[Nu]f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shift", " ", "[", 
