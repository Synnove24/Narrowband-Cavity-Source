Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", " ", "=", " ", 
     RowBox[{".4", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]so", " ", "=", " ", 
     RowBox[{"810", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Reflectivity", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R1", " ", "=", " ", ".999"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R2", " ", "=", " ", ".98"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r1", " ", "=", " ", 
     SqrtBox["R1"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r2", " ", "=", " ", 
     SqrtBox["R2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "loss", " ", "coefficient", " ", "for", " ", "absorption", " ", "for", " ",
      "PPKTP", " ", "at", " ", "775", " ", 
     RowBox[{"(", 
      RowBox[{"ppm", "/", "cm"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]s", " ", "=", " ", 
     RowBox[{"127", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]], "*", "100"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]r", "[", 
      RowBox[{"L_", ",", "R1_", ",", "R2_"}], "]"}], " ", ":=", " ", 
     RowBox[{"\[Alpha]s", "+", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "*", "L"}]], 
       RowBox[{"Log", "[", 
        FractionBox["1", 
         RowBox[{"R1", "*", "R2"}]], "]"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"intracavity", " ", "loss"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Alpha]r", " ", "=", " ", ".18633"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Finesse", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Fnoloss", "[", 
      RowBox[{"r1_", ",", "r2_"}], "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"\[Pi]", 
       SqrtBox[
        RowBox[{"r1", "*", "r2"}]]}], 
      RowBox[{"1", "-", 
       RowBox[{"r1", "*", "r2"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"L_", ",", "R1_", ",", "R2_"}], "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"\[Pi]", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Alpha]r", "[", 
           RowBox[{"L", ",", "R1", ",", "R2"}], "]"}]}], "*", 
         RowBox[{"L", "/", "2"}]}], "]"}]}], 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Alpha]r", "[", 
           RowBox[{"L", ",", "R1", ",", "R2"}], "]"}]}], "*", "L"}], 
        "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The finesse is \>\"", ",", " ", 
      RowBox[{"N", "[", 
       RowBox[{"F", "[", 
        RowBox[{"L", ",", "R1", ",", "R2"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Free", " ", "spectral", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]f", "[", "L_", "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"c", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], 
      RowBox[{"2", "*", "L", "*", 
       RowBox[{"nz", "[", 
        RowBox[{"\[Lambda]so", "*", 
         SuperscriptBox["10", "6"]}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ng", "[", "\[Lambda]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"nz", "[", "\[Lambda]", "]"}], "-", 
      RowBox[{"\[Lambda]", "*", 
       RowBox[{
        RowBox[{"nz", "'"}], "[", "\[Lambda]", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]fg", "[", "L_", "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"c", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], 
      RowBox[{"2", "*", "L", "*", 
       RowBox[{"ng", "[", 
        RowBox[{"\[Lambda]so", "*", 
         SuperscriptBox["10", "6"]}], "]"}]}]]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<the group index is: \>\"", ",", 
       RowBox[{"ng", "[", 
        RowBox[{"\[Lambda]so", "*", 
         RowBox[{"10", "^", "6"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<the normal index is: \>\"", ",", " ", 
       RowBox[{"nz", "[", 
        RowBox[{"\[Lambda]so", "*", 
         RowBox[{"10", "^", "6"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<The FSR using group index is: \>\"", ",", " ", 
       RowBox[{"\[Nu]fg", "[", "L", "]"}], ",", " ", "\"\< GHz\>\""}], "]"}], 
     ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spectral", " ", "width"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sw", "[", 
      RowBox[{"L_", ",", "R1_", ",", "R2_"}], "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"\[Nu]f", "[", "L", "]"}], 
      RowBox[{"F", "[", 
       RowBox[{"L", ",", "R1", ",", "R2"}], "]"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"swnoloss", "[", 
      RowBox[{"L_", ",", "r1_", ",", "r2_"}], "]"}], " ", ":=", " ", 
     FractionBox[
      RowBox[{"\[Nu]f", "[", "L", "]"}], 
      RowBox[{"Fnoloss", "[", 
       RowBox[{"r1", ",", "r2"}], "]"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The spectral width is: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"sw", "[", 
        RowBox[{"L", ",", "R1", ",", "R2"}], "]"}], "]"}], "*", 
      RowBox[{"10", "^", "9"}]}], ",", " ", "\"\< Hz\>\""}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The spectral width with no loss is: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"swnoloss", "[", 
        RowBox[{"L", ",", "r1", ",", "r2"}], "]"}], "]"}], "*", 
      RowBox[{"10", "^", "9"}]}], ",", " ", "\"\< Hz\>\""}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Internal", " ", "resonator", " ", "intensity"}], "*)"}], "\[IndentingNewLine]", 
