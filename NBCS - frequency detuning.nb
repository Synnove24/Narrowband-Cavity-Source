   RowBox[{"ArcCos", "[", 
    SqrtBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"L", "/", "RC"}]}], ")"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
