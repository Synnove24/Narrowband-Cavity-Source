 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{"ArcTan", "[", 
    FractionBox["L", 
     RowBox[{"z0", "[", 
      RowBox[{"RC", ",", "L"}], "]"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
