Cell[CellGroupData[{

Cell["ABCD Matrices for Hemispherical Cavity", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
 CellChangeTimes->{{3.987793201770483*^9, 
  3.987793257750599*^9}},ExpressionUUID->"d6daf963-b725-4a48-a789-\
0e15395317a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RC", " ", "=", " ", 
    RowBox[{"1", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]so", " ", "=", " ", 
   RowBox[{"850", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", 
   RowBox[{".5", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m2", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", "propagation", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3", "[", "RC_", "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "/", "RC"}], ",", "1"}], "}"}]}], "}"}]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{
   "curved", " ", "mirror", " ", "as", " ", "a", " ", "function", " ", "of", " ",
     "radius", " ", "of", " ", "curvature"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ABCD", "[", "RC_", "]"}], " ", ":=", " ", 
   RowBox[{"m1", ".", "m2", ".", 
    RowBox[{"m3", "[", "RC", "]"}], ".", "m2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<ABCD Matrix: \>\"", ",", " ", "ABCD"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mA", "[", "RC_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", "RC", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mB", "[", "RC_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", "RC", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mC", "[", "RC_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", "RC", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mD", "[", "RC_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"ABCD", "[", "RC", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RC1", "[", "RC_", "]"}], " ", ":=", " ", 
    FractionBox[
     RowBox[{"2", "*", 
      RowBox[{"mB", "[", "RC", "]"}]}], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mA", "[", "RC", "]"}], "-", 
        RowBox[{"mD", "[", "RC", "]"}]}], ")"}]}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Radius", " ", "of", " ", "curvature", " ", "of", " ", "Gaussian", " ", 
    "beam", " ", "at", " ", "first", " ", "flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"W1", "[", "RC_", "]"}], " ", ":=", 
    RowBox[{
     SqrtBox[
      RowBox[{"(", 
       FractionBox["\[Lambda]so", 
        RowBox[{
         RowBox[{"nz", "[", 
          RowBox[{"\[Lambda]so", "*", 
           SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]"}]], ")"}]], 
     SqrtBox[
      FractionBox[
       RowBox[{"Abs", "[", 
        RowBox[{"mB", "[", "RC", "]"}], "]"}], 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"mA", "[", "RC", "]"}], "+", 
             RowBox[{"mD", "[", "RC", "]"}]}], "2"], ")"}], "2"]}]]]]}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "beam", " ", "waist", " ", "at", " ", "first", " ", "flat", " ", 
    "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z0", "[", "RC_", "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"nz", "[", 
      RowBox[{"\[Lambda]so", "*", 
       SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]", "*", 
     SuperscriptBox[
      RowBox[{"W1", "[", "RC", "]"}], "2"]}], "\[Lambda]so"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RC2", "[", 
    RowBox[{"l_", ",", "RC_"}], "]"}], " ", ":=", "  ", 
   RowBox[{"l", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"z0", "[", "RC", "]"}], "l"], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
