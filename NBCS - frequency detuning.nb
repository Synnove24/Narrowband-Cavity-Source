Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{"ArcTan", "[", 
    FractionBox["L", 
     RowBox[{"z0", "[", 
      RowBox[{"RC", ",", "L"}], "]"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Zeta]2", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArcCos", "[", 
    SqrtBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"L", "/", "RC"}]}], ")"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q_", ",", "z_", ",", "m_", ",", "RC_", ",", "L_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"q", "*", 
      RowBox[{"\[Nu]f", "[", "L", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "+", "m", "+", "1"}], ")"}], " ", 
      FractionBox[
       RowBox[{"\[CapitalDelta]\[Zeta]", "[", 
        RowBox[{"RC", ",", "L"}], "]"}], "\[Pi]"], 
      RowBox[{"\[Nu]f", "[", "L", "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", "resonances", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shift", " ", "[", 
    RowBox[{
    "q1_", ",", "z1_", ",", "m1_", ",", "q2_", ",", "z2_", ",", "m2_", ",", 
     "RC_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q2", ",", "z2", ",", "m2", ",", "RC", ",", "L"}], "]"}], " ", "-",
     " ", 
    RowBox[{"\[Nu]HG", "[", 
     RowBox[{"q1", ",", "z1", ",", "m1", ",", "RC", ",", "L"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The frequency shift from TEM00 to TEM01 is \>\"", ",", 
    RowBox[{"shift", "[", 
     RowBox[{
     "1", ",", "0", ",", "0", ",", "1", ",", "0", ",", "1", ",", "RC", ",", 
      "L"}], "]"}], ",", " ", "\"\< Ghz\>\""}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<TEM00 resonances: \>\"", ",", 
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"0", ",", "0", ",", "0", ",", "RC", ",", "L"}], "]"}], 
   ",", "\"\< GHz\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<TEM10 resonance: \>\"", ",", 
   RowBox[{"\[Nu]HG", "[", 
    RowBox[{"0", ",", "1", ",", "0", ",", "RC", ",", "L"}], "]"}], 
   ",", "\"\< GHz\>\""}], "]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<TEM20 resonance: \>\"", ",", 
    RowBox[{"\[Nu]HG", "[", 
