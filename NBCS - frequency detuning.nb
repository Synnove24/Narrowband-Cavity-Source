Cell[CellGroupData[{

Cell["ABCD Matrices for Hemispherical Cavity", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
 CellChangeTimes->{{3.987793201770483*^9, 
  3.987793257750599*^9}},ExpressionUUID->"d6daf963-b725-4a48-a789-\
0e15395317a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RC", " ", "=", " ", 
    RowBox[{"1", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]so", " ", "=", " ", 
   RowBox[{"780", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", 
   RowBox[{"0.5", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m2", "[", "L_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", "propagation", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3", "[", "RC_", "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "/", "RC"}], ",", "1"}], "}"}]}], "}"}]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{
   "curved", " ", "mirror", " ", "as", " ", "a", " ", "function", " ", "of", " ",
     "radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nair", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ABCD", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
    RowBox[{"m1", ".", 
     RowBox[{"m2", "[", "L", "]"}], ".", 
     RowBox[{"m3", "[", "RC", "]"}], ".", 
     RowBox[{"m2", "[", "L", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mA", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
