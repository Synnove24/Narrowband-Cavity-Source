Cell[CellGroupData[{

Cell["JSI (cavity)", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10005.},
 CellChangeTimes->{{3.987258744445141*^9, 
  3.987258766538393*^9}},ExpressionUUID->"b1747a9b-63fa-084e-8c4b-\
c7a3c5cbc448"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"JSA", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s_", ",", "\[CapitalDelta]\[Nu]i_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"\[Phi]", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}],
       "*", 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", " ", "\[CapitalDelta]\[Nu]i"}], 
       "]"}], "*", 
      RowBox[{"Intensity", "[", "\[CapitalDelta]\[Nu]s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"JSI", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s_", ",", " ", "\[CapitalDelta]\[Nu]i_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"JSA", "[", 
       RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}],
       "*", 
      RowBox[{"Conjugate", "[", 
       RowBox[{"JSA", "[", 
        RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], 
        "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"JSI", "[", 
      RowBox[{"\[CapitalDelta]\[Nu]s", ",", "\[CapitalDelta]\[Nu]i"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]s", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]\[Nu]i", ",", 
       RowBox[{"-", "\[Delta]\[Nu]2"}], ",", "\[Delta]\[Nu]2"}], "}"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", " ", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", 
     RowBox[{"PlotLabel", "->", "\"\<JSI\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
