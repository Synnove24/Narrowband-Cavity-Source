   3.987858245651367*^9, {3.9878682869878254`*^9, 3.987868296689909*^9}, {
   3.98787228389678*^9, 3.9878723089414406`*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"77d565d9-e3d1-a445-a47c-deb7c41d08f4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ABCD Matrix: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
