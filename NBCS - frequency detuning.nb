       RowBox[{"(", "12", ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]t", " ", "=", " ", 
     RowBox[{".441", "/", 
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]f", "*", 
        RowBox[{"10", "^", 
         RowBox[{"(", "12", ")"}]}]}], ")"}]}]}], ";"}], " ", 
   RowBox[{"(*", "s", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmin", "=", 
     RowBox[{
      RowBox[{"-", "5"}], "*", "\[CapitalDelta]t"}]}], ";"}], "\n", 
