   3.999100778842593*^9},ExpressionUUID->"3d31e5ce-6d67-4ba2-809d-\
834bd4e296d4"],

Cell[BoxData[
 RowBox[{"\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]nztemp", "[", 
      RowBox[{"\[Lambda]_", ",", "T_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"n1z", "[", "\[Lambda]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"T", "-", " ", "25"}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"n2z", "[", "\[Lambda]", "]"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"T", " ", "-", " ", "25"}], ")"}], "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nztemp", "[", 
      RowBox[{"\[Lambda]_", ",", "T_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Az", " ", "+", " ", 
        RowBox[{"Bz", "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Cz", "/", 
            RowBox[{"(", 
             RowBox[{"\[Lambda]", "^", "2"}], ")"}]}]}], ")"}]}], " ", "+", 
        " ", 
        RowBox[{"Dz", "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Ez", "/", 
            RowBox[{"(", 
             RowBox[{"\[Lambda]", "^", "2"}], ")"}]}]}], ")"}]}], " ", "-", 
        " ", 
        RowBox[{"Fz", "*", 
         RowBox[{"\[Lambda]", "^", "2"}]}]}], "]"}], " ", "+", " ", 
      RowBox[{"\[CapitalDelta]nztemp", "[", 
       RowBox[{"\[Lambda]", ",", "T"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a\[Alpha]z", " ", "=", " ", 
     RowBox[{"0.02", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b\[Alpha]z", " ", "=", " ", 
     RowBox[{"6.5", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lz", "[", "T_", "]"}], ":=", 
     RowBox[{"4", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"a\[Alpha]z", 
         RowBox[{"(", 
          RowBox[{"T", "-", "31.85"}], ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], "b\[Alpha]z", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"T", "-", "31.85"}], ")"}], "2"]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"nztemp", "[", 
      RowBox[{".81", ",", "T"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "20", ",", "50"}], "}"}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Index of Refraction vs. Temperature\>\""}], ",", 
     " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Temperature (C)\>\"", 
        ",", "\"\<Index of Refraction\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Lz", "[", "T", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "30", ",", "60"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Length vs. Temperature\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Temperature(C)\>\"", ",", "\"\<Length(m)\>\""}], 
       "}"}]}]}], "]"}]}]}]], "Input",
