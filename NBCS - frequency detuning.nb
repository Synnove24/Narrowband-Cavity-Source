Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]po", " ", "=", " ", 
    RowBox[{"520", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "9"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]so", " ", "=", " ", 
    RowBox[{"780", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "9"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]io", " ", "=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "\[Lambda]po"}], " ", "-", 
      RowBox[{"1", "/", "\[Lambda]so"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", " ", "=", " ", 
    RowBox[{"3", "*", 
     RowBox[{"10", "^", "8"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The central wavelength for the idler is \>\"", ",", " ", 
    RowBox[{"N", "[", "\[Lambda]io", "]"}], ",", " ", "\"\<m\>\""}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]po", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", 
    RowBox[{"c", "/", "\[Lambda]po"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]so", " ", "=", " ", 
   RowBox[{"2", "\[Pi]", " ", 
    RowBox[{"c", "/", "\[Lambda]so"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]io", " ", "=", " ", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"c", "/", "\[Lambda]io"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kpo", " ", "=", " ", 
   RowBox[{
    RowBox[{"nz", "[", 
     RowBox[{"\[Lambda]po", "*", 
      RowBox[{"10", "^", "6"}]}], "]"}], "*", 
    RowBox[{"\[Omega]po", "/", "c"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kso", " ", "=", " ", 
   RowBox[{
    RowBox[{"nz", "[", 
     RowBox[{"\[Lambda]so", "*", 
      RowBox[{"10", "^", "6"}]}], "]"}], "*", 
    RowBox[{"\[Omega]so", "/", "c"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kio", " ", "=", " ", 
    RowBox[{
     RowBox[{"nz", "[", 
      RowBox[{"\[Lambda]io", "*", 
       RowBox[{"10", "^", "6"}]}], "]"}], "*", 
     RowBox[{"\[Omega]io", "/", "c"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"\[Pi]", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "kpo"}], " ", "+", " ", "kso", " ", "+", "kio"}], 
        ")"}]}]}], ")"}], "*", 
    RowBox[{"10", "^", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The poling period is \>\"", ",", " ", 
   RowBox[{"N", "[", "\[CapitalLambda]", "]"}], ",", 
   " ", "\"\< microns\>\""}], "]"}], "\[IndentingNewLine]"}], "Input",
