Cell[CellGroupData[{

Cell["ABCD Matrices for Hemispherical Cavity", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
 CellChangeTimes->{{3.987793201770483*^9, 
  3.987793257750599*^9}},ExpressionUUID->"d6daf963-b725-4a48-a789-\
0e15395317a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RC", " ", "=", " ", 
    RowBox[{"1", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]so", " ", "=", " ", 
   RowBox[{"810", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", 
   RowBox[{"0.3", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m2", "[", "L_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", "propagation", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3", "[", "RC_", "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "/", "RC"}], ",", "1"}], "}"}]}], "}"}]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{
   "curved", " ", "mirror", " ", "as", " ", "a", " ", "function", " ", "of", " ",
     "radius", " ", "of", " ", "curvature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nair", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ABCD", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
    RowBox[{"m1", ".", 
     RowBox[{"m2", "[", "L", "]"}], ".", 
     RowBox[{"m3", "[", "RC", "]"}], ".", 
     RowBox[{"m2", "[", "L", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mA", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", 
     RowBox[{"RC", ",", "L"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mB", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", 
     RowBox[{"RC", ",", "L"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mC", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ABCD", "[", 
     RowBox[{"RC", ",", "L"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mD", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"ABCD", "[", 
      RowBox[{"RC", ",", "L"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stability", "[", 
    RowBox[{"RC1_", ",", " ", "RC2_", ",", " ", "L_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["L", "RC1"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["L", "RC2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hemiStability", "[", 
    RowBox[{"RC2_", ",", "L_"}], "]"}], ":=", " ", 
   RowBox[{"(", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox["L", "RC2"]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The stability is: \>\"", ",", " ", 
     RowBox[{"hemiStability", "[", 
      RowBox[{"RC", ",", "L"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RC1", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
    FractionBox[
     RowBox[{"2", "*", 
      RowBox[{"mB", "[", 
       RowBox[{"RC", ",", "L"}], "]"}]}], 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mA", "[", 
         RowBox[{"RC", ",", "L"}], "]"}], "-", 
        RowBox[{"mD", "[", 
         RowBox[{"RC", ",", "L"}], "]"}]}], ")"}]}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Radius", " ", "of", " ", "curvature", " ", "of", " ", "Gaussian", " ", 
    "beam", " ", "at", " ", "first", " ", "flat", " ", "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"W1", "[", 
     RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", 
    RowBox[{
     SqrtBox[
      RowBox[{"(", 
       FractionBox["\[Lambda]so", 
        RowBox[{
         RowBox[{"nz", "[", 
          RowBox[{"\[Lambda]so", "*", 
           SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]"}]], ")"}]], 
     SqrtBox[
      FractionBox[
       RowBox[{"Abs", "[", 
        RowBox[{"mB", "[", 
         RowBox[{"RC", ",", "L"}], "]"}], "]"}], 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"mA", "[", 
              RowBox[{"RC", ",", "L"}], "]"}], "+", 
             RowBox[{"mD", "[", 
              RowBox[{"RC", ",", "L"}], "]"}]}], "2"], ")"}], "2"]}]]]]}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "beam", " ", "waist", " ", "at", " ", "first", " ", "flat", " ", 
    "mirror"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z0", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"nz", "[", 
      RowBox[{"\[Lambda]so", "*", 
       SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]", "*", 
     SuperscriptBox[
      RowBox[{"W1", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "2"]}], "\[Lambda]so"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RC2", "[", 
    RowBox[{"z_", ",", "RC_", ",", "L_"}], "]"}], " ", ":=", "  ", 
   RowBox[{"z", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"z0", "[", 
          RowBox[{"RC", ",", "L"}], "]"}], "z"], ")"}], "2"]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"W2", "[", 
    RowBox[{"z_", ",", "RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"W1", "[", 
     RowBox[{"RC", ",", "L"}], "]"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["z", 
          RowBox[{"z0", "[", 
           RowBox[{"RC", ",", "L"}], "]"}]], ")"}], "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Div1", "[", 
    RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
   FractionBox["\[Lambda]so", 
    RowBox[{"\[Pi]", "*", "nair", "*", 
     RowBox[{"W1", "[", 
      RowBox[{"RC", ",", "L"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The beam divergence is: \>\"", ",", 
