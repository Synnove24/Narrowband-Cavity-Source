Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n_air", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"m4", "[", "RC_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nz", "[", 
             RowBox[{"\[Lambda]so", "*", 
              SuperscriptBox["10", "6"]}], "]"}], "-", "n_air"}], ")"}], 
          RowBox[{"n_air", "*", "RC"}]], ",", 
         FractionBox[
          RowBox[{"nz", "[", 
           RowBox[{"\[Lambda]so", "*", 
            SuperscriptBox["10", "6"]}], "]"}], "n_air"]}], "}"}]}], "}"}]}], 
    ";"}], " ", 
   RowBox[{"(*", "refraction", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ABCD_refraction", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{"m1", ".", 
      RowBox[{"m2", "[", "L", "]"}], ".", 
      RowBox[{"m3", "[", "RC", "]"}], ".", 
      RowBox[{"m2", "[", "L", "]"}], ".", "m1", ".", 
      RowBox[{"m2", "[", "L", "]"}], ".", 
      RowBox[{"m4", "[", "RC", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mA_r", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCD_refraction", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mB_r", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCD_refraction", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mC_r", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCD_refraction", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mD_r", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ABCD_refraction", "[", 
       RowBox[{"RC", ",", "L"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"W1_r", "[", 
      RowBox[{"RC_", ",", "L_"}], "]"}], " ", ":=", 
     RowBox[{
      SqrtBox[
       RowBox[{"(", 
        FractionBox["\[Lambda]so", 
         RowBox[{
          RowBox[{"nz", "[", 
           RowBox[{"\[Lambda]so", "*", 
            SuperscriptBox["10", "6"]}], "]"}], "*", "\[Pi]"}]], ")"}]], 
      SqrtBox[
       FractionBox[
        RowBox[{"Abs", "[", 
         RowBox[{"mB_r", "[", 
          RowBox[{"RC", ",", "L"}], "]"}], "]"}], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{
              RowBox[{"mA_r", "[", 
               RowBox[{"RC", ",", "L"}], "]"}], "+", 
              RowBox[{"mD_r", "[", 
               RowBox[{"RC", ",", "L"}], "]"}]}], "2"], ")"}], "2"]}]]]]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{
