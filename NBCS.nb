     RowBox[{
      RowBox[{"JSA", "[", 
       RowBox[{"\[Nu]s", ",", "\[Nu]i"}], "]"}], "*", 
      RowBox[{"Conjugate", "[", 
       RowBox[{"JSA", "[", 
        RowBox[{"\[Nu]s", ",", "\[Nu]i"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
