Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"JSA", "[", 
      RowBox[{"\[Nu]s_", ",", "\[Nu]i_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"\[Phi]", "[", 
       RowBox[{"\[Nu]s", ",", "\[Nu]i"}], "]"}], "*", 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"\[Nu]s", ",", " ", "\[Nu]i"}], "]"}], "*", 
      RowBox[{"Intensity", "[", "\[Nu]s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"JSI", "[", 
